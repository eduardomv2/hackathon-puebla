# SOLO LOCAL: las Edge Functions escriben en la bandeja simulada en lugar de enviar
# por WhatsApp/SMS reales. En producción esta variable NO debe existir.
MODO_SIMULADOR=true
# Opcional: con una clave, procesar-resumenes usa Claude; sin ella, el resumen sale por plantilla.
# ANTHROPIC_API_KEY=
# Producción (sin MODO_SIMULADOR): WhatsApp Cloud API de Meta
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_PLANTILLA_OTP=codigo_verificacion
# WHATSAPP_IDIOMA=es_MX
# Pruebas locales: estos números se envían de verdad aunque MODO_SIMULADOR esté activo
# (los demás siguen simulados). Con el número de prueba de Meta, deben estar en su lista.
# TELEFONOS_REALES=52XXXXXXXXXX,52XXXXXXXXXX
# Código de verificación: whatsapp_y_sms (por omisión), whatsapp o sms
# CANAL_CODIGO=whatsapp_y_sms
# SMS de respaldo (Vonage)
# VONAGE_API_KEY=
# VONAGE_API_SECRET=
# VONAGE_REMITENTE=
# Pago de prueba sin pasarela (función pago-demo y "PAGAR" en WhatsApp). Apagado por omisión.
# PAGO_DEMO=false
